{
  "name": "amway-champion-server",
  "version": "1.0.0",
  "description": "Amway 챔피언팀 공식 웹사이트 - 백엔드 API 서버",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate",
    "start:prod": "prisma db push --skip-generate --accept-data-loss && node scripts/ensureSeed.js && node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js",
    "db:setup": "prisma migrate dev --name init && node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "prisma": "^5.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}

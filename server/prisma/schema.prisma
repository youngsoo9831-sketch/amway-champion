// Amway 챔피언팀 공식 웹사이트 - Prisma 스키마
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int
  summary     String?
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Post {
  id                Int        @id @default(autoincrement())
  boardType         String     @default("FREE") // "FREE"(자유 게시판) | "MEMBER"(회원 전용 게시판)
  title             String
  author            String
  content           String
  authorMemberId    Int?
  authorMember      Member?    @relation(fields: [authorMemberId], references: [id])
  guestPasswordHash String? // 비회원 작성 글의 수정/삭제용 비밀번호 해시
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  comments          Comment[]
  reactions         Reaction[]
}

model Comment {
  id             Int      @id @default(autoincrement())
  postId         Int
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  content        String
  author         String
  authorMemberId Int?
  authorMember   Member?  @relation(fields: [authorMemberId], references: [id])
  createdAt      DateTime @default(now())
}

model Reaction {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id])
  emoji     String // "LIKE" | "LOVE" | "HAHA" | "WOW" | "SAD" | "CLAP"
  createdAt DateTime @default(now())

  @@unique([postId, memberId, emoji])
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
}

model Member {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  posts        Post[]
  comments     Comment[]
  reactions    Reaction[]
}
